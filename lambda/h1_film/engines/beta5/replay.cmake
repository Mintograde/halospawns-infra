function(hs_beta5_replace input anchor replacement)
    string(FIND "${${input}}" "${anchor}" first)
    string(FIND "${${input}}" "${anchor}" last REVERSE)
    if(first EQUAL -1 OR NOT first EQUAL last)
        message(FATAL_ERROR "Beta 5 replay anchor changed: ${anchor}")
    endif()
    string(REPLACE "${anchor}" "${replacement}" content "${${input}}")
    set(${input} "${content}" PARENT_SCOPE)
endfunction()

function(hs_beta5_replay_source name input output)
    set(content "${${input}}")
    if(name STREQUAL "blampc_film_join.c")
        string(REGEX MATCH "    if \\(seat < 0\\)\n    \\{[^}]*return -1;\n    \\}" refused "${content}")
        if(NOT refused)
            message(FATAL_ERROR "Beta 5 join seat guard changed")
        endif()
        hs_beta5_replace(content "${refused}" "    if (seat < 0) seat = 0xFFFF;")
        hs_beta5_replace(content "created = player_new(0, -1, (unsigned short)seat, &np);" "created = player_new(absolute_index / 4, -1, (unsigned short)seat, &np);")
        hs_beta5_replace(content "local_player_set_player_index((short)seat, created);" "if (seat < 4) local_player_set_player_index((short)seat, created);")
        hs_beta5_replace(content "    return seat;\n}" "    hs_register_players();\n    return seat;\n}")
        string(PREPEND content "extern void hs_register_players(void);\n")
    elseif(name STREQUAL "blampc_film.c")
        hs_beta5_replace(content "film_view_follow_joined(j.player_index, seat);" "if (seat < 4) film_view_follow_joined(j.player_index, seat);")
        hs_beta5_replace(content "if (count < 1 || count > MAXIMUM_NUMBER_OF_LOCAL_PLAYERS)" "if (count < 1 || count > BLAMPC_FILM_ROSTER_MAX)")
        hs_beta5_replace(content "opts->players = count;" "opts->players = count < 4 ? count : 4;")
        file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/roster.c" roster_source)
        string(APPEND content "\n${roster_source}")
    elseif(name STREQUAL "create_local_players.c")
        hs_beta5_replace(content "i < player_spawn_count;" "i < hs_film_initial_count(player_spawn_count);")
        hs_beta5_replace(content "int player_index = player_new(0, -1, local_player_index, 0);" "int player_index = player_new(i / 4, -1, local_player_index, 0);")
        hs_beta5_replace(content "local_player_set_player_index(local_player_index, player_index);" "if (local_player_index >= 0) local_player_set_player_index(local_player_index, player_index);")
        hs_beta5_replace(content "p->network_player_data.player_list_index = (char)local_player_index;" "p->network_player_data.player_list_index = (char)i;\n                hs_film_initial_player(player_index);")
        hs_beta5_replace(content "blampc_bots_create_players();" "blampc_bots_create_players();\n            hs_register_players();")
        string(PREPEND content "extern int hs_film_initial_count(int);\nextern void hs_film_initial_player(int);\nextern void hs_register_players(void);\n")
    elseif(name STREQUAL "game_engine_player_added.c")
        string(REGEX MATCHALL "blampc_teams_creation_team\\(player->local_player_index\\)" calls "${content}")
        list(LENGTH calls count)
        if(NOT count EQUAL 3)
            message(FATAL_ERROR "Beta 5 creation team source changed")
        endif()
        string(REPLACE "blampc_teams_creation_team(player->local_player_index)" "hs_film_creation_team(player_index, blampc_teams_creation_team(player->local_player_index))" content "${content}")
        string(PREPEND content "extern int hs_film_creation_team(int, int);\n")
    endif()
    if(content STREQUAL "${${input}}")
        message(FATAL_ERROR "Beta 5 replay source did not match: ${name}")
    endif()
    set(${output} "${content}" PARENT_SCOPE)
endfunction()
