option(H1_GAMEPLAY_EXPORT "Capture ordered gameplay evidence" OFF)
function(hs_gameplay_target target)
    if(NOT H1_GAMEPLAY_EXPORT)
        return()
    endif()
    if(NOT H1_COMBAT_EXPORT)
        message(FATAL_ERROR "Gameplay evidence requires combat hooks")
    endif()
    target_compile_definitions(${target} PRIVATE H1_GAMEPLAY_EXPORT=1)
    if(H1_MELEE_EXPORT)
        target_compile_definitions(${target} PRIVATE H1_MELEE_EXPORT=1)
    endif()
    get_target_property(sources ${target} SOURCES)
    set(found 0)
    foreach(source IN LISTS sources)
        if(NOT IS_ABSOLUTE "${source}")
            set(source "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
        endif()
        if(EXISTS "${source}")
            file(READ "${source}" content)
            if(content MATCHES "\nint blampc_universal_film_deal\\([^;]+\\)[\r\n ]*\\{")
                set_property(SOURCE "${source}" TARGET_DIRECTORY ${target} APPEND PROPERTY
                    COMPILE_DEFINITIONS blampc_universal_film_deal=hs_original_universal_film_deal)
                math(EXPR found "${found}+1")
            endif()
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        message(FATAL_ERROR "Gameplay requires exactly one network damage implementation, got ${found}")
    endif()
endfunction()
