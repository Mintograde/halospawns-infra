function(hs_combat_patch source input output)
    set(content "${${input}}")
    get_filename_component(stem "${source}" NAME_WE)
    set(wrapped weapon_trigger_fire projectile_new projectile_update projectile_collision
        projectile_detonate effect_allocate effect_update object_cause_damage
        object_damage_aftermath unit_cause_player_melee_damage game_statistics_record_kill)
    if(stem IN_LIST wrapped)
        string(REGEX MATCHALL "\n(void|int|uint8_t) ${stem}\\(" declarations "${content}")
        list(LENGTH declarations count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Combat hook requires one definition: ${stem}")
        endif()
        string(REGEX REPLACE "\n(void|int|uint8_t) ${stem}\\(" "\n\\1 hs_original_${stem}(" content "${content}")
    endif()
    if(stem STREQUAL "weapon_trigger_fire")
        set(anchor "if ( did_fire )\n    {")
        set(replacement "${anchor}\n        hs_combat_discharge(weapon_index, owner_unit_index);")
    elseif(stem STREQUAL "object_cause_damage")
        set(anchor "vitality_removed = vitality_shield_taken + vitality_body_taken;")
        set(replacement "${anchor}\n            hs_combat_applied(damage_data, current_object_index, should_do_actual_damage,\n                vitality_shield_before, vitality_shield_after, vitality_shield_maximum,\n                vitality_body_before, vitality_body_after, vitality_body_maximum, body_part);")
    elseif(stem STREQUAL "object_damage_body")
        set(anchor "*damage_flags_accumulator |= (1u << _object_being_damaged_killed_instantly_bit);")
        set(replacement "${anchor}\n                    if (should_do_actual_damage == 1) hs_combat_headshot(object_index);")
    elseif(stem STREQUAL "unit_cause_player_melee_damage")
        set(anchor "damage_data_new(&damage, damage_definition_index);")
        set(replacement "hs_combat_melee(damage_definition_index);\n            ${anchor}")
    endif()
    if(DEFINED anchor)
        string(FIND "${content}" "${anchor}" first)
        string(FIND "${content}" "${anchor}" last REVERSE)
        if(first EQUAL -1 OR NOT first EQUAL last)
            message(FATAL_ERROR "Combat source anchor changed: ${stem}")
        endif()
        string(REPLACE "${anchor}" "${replacement}" content "${content}")
    endif()
    if(stem STREQUAL "game_engine_player_killed")
        string(REPLACE "blampc_film_note_death" "hs_combat_death" content "${content}")
        string(REPLACE "blampc_pgcr_stats_note_multikill" "hs_combat_multikill" content "${content}")
    elseif(stem STREQUAL "game_statistics_record_kill")
        string(REPLACE "blampc_pgcr_stats_note_kill" "hs_combat_kill" content "${content}")
    endif()
    if(NOT content STREQUAL "${${input}}")
        string(PREPEND content "#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/combat-hooks.h\"\n")
    endif()
    set(${output} "${content}" PARENT_SCOPE)
endfunction()

function(hs_combat_native)
    get_target_property(sources blam SOURCES)
    set(patched_sources)
    foreach(source IN LISTS sources)
        file(READ "${source}" original)
        hs_combat_patch("${source}" original patched)
        if(NOT original STREQUAL patched)
            get_filename_component(name "${source}" NAME)
            set(destination "${CMAKE_CURRENT_BINARY_DIR}/combat/${name}")
            file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/combat")
            file(WRITE "${destination}" "${patched}")
            list(APPEND patched_sources "${destination}")
            if(name STREQUAL "object_cause_damage.c")
                set_property(SOURCE "${destination}" TARGET_DIRECTORY blam
                    APPEND PROPERTY COMPILE_DEFINITIONS blampc_pgcr_stats_note_damage=hs_note_damage)
            endif()
        else()
            list(APPEND patched_sources "${source}")
        endif()
    endforeach()
    set_property(TARGET blam PROPERTY SOURCES "${patched_sources}")
    target_compile_definitions(blampc PRIVATE H1_COMBAT_EXPORT=1)
endfunction()
