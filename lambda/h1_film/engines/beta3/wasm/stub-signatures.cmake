# The native stubs deliberately ignore cdecl arguments. WASM requires the
# lowered signature to match even when a stub does not inspect those arguments.
file(READ "${H1_SOURCE}/host/stubs/blampc_stubs_functions.c" typed_stubs)
macro(typed_stub name result arguments)
    if("${result}" STREQUAL "void")
        set(stub_return "")
    else()
        set(stub_return "return 0;")
    endif()
    string(REGEX REPLACE "(int|void|float) ${name}\\(\\) \\{[^}]*\\}"
        "${result} ${name}(${arguments}) { blampc_stub_hit(\"${name}\"); ${stub_return} }" typed_stubs "${typed_stubs}")
endmacro()
