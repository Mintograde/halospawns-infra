option(H1_VERIFIED_POV_RECOVERY "Recover source-bound embedded client shots after a verified desync" OFF)

function(hs_pov_replace_source target filename anchor replacement)
    get_target_property(sources ${target} SOURCES)
    get_target_property(base ${target} SOURCE_DIR)
    set(matches 0)
    foreach(source IN LISTS sources)
        get_filename_component(name "${source}" NAME)
        if(name STREQUAL filename)
            math(EXPR matches "${matches}+1")
            get_filename_component(input "${source}" ABSOLUTE BASE_DIR "${base}")
            file(READ "${input}" content)
            string(FIND "${content}" "${anchor}" first)
            string(FIND "${content}" "${anchor}" last REVERSE)
            if(first EQUAL -1 OR NOT first EQUAL last)
                message(FATAL_ERROR "POV recovery anchor changed in ${input}")
            endif()
            string(REPLACE "${anchor}" "${replacement}" content "${content}")
            set(output "${CMAKE_CURRENT_BINARY_DIR}/pov-${filename}")
            # Retain per-source includes when moving a translation unit.
            get_filename_component(original_dir "${input}" DIRECTORY)
            file(CONFIGURE OUTPUT "${output}" CONTENT "${content}" @ONLY)
            set_property(SOURCE "${output}" TARGET_DIRECTORY ${target} APPEND PROPERTY INCLUDE_DIRECTORIES "${original_dir}")
            list(REMOVE_ITEM sources "${source}")
            list(APPEND sources "${output}")
        endif()
    endforeach()
    if(NOT matches EQUAL 1)
        message(FATAL_ERROR "Expected one ${filename} in ${target}")
    endif()
    set_property(TARGET ${target} PROPERTY SOURCES "${sources}")
endfunction()

function(hs_verified_pov_target target)
    if(NOT H1_VERIFIED_POV_RECOVERY)
        return()
    endif()
    set(trigger "            /* parallel-fire:")
    hs_pov_replace_source(blam trigger_create_projectiles.c "${trigger}"
        "            { extern void hs_pov_round(int,int,int,int,int,float *); hs_pov_round(controlling_player, trigger_index, shot, weapon->definition_index, placement.definition_index, placement.forward.n); }\n${trigger}")
    set(tuning "void blampc_tuning_apply(const blampc_boot_options *opts)\n{")
    hs_pov_replace_source(${target} blampc_tuning.c "${tuning}"
        "${tuning}\n    extern int hs_pov_rules(float,float,float *,float *);\n    blampc_boot_options restored;\n    float pistol, sniper;\n    if (opts && hs_pov_rules(opts->tune_weapon[0].autoaim_angle, opts->tune_weapon[1].autoaim_angle, &pistol, &sniper)) {\n        restored = *opts;\n        restored.tune_weapon[0].autoaim_angle = pistol;\n        restored.tune_weapon[1].autoaim_angle = sniper;\n        opts = &restored;\n    }")
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pov_recovery.c")
endfunction()
