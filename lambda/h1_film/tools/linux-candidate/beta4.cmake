set(H1_NETWORK_REPLAY_FIXES ON)
include("/engines/beta4/replay.cmake")
include("/engines/beta4/network-replay.cmake")
include("/engines/beta3/combat.cmake")
target_compile_definitions(blam_server PRIVATE H1_LINUX_BETA4=1 H1_EXPORT_MAX_PLAYERS=16 H1_COMBAT_EXPORT=1 H1_DAMAGE_ATTRIBUTION=1 H1_FINITE_WORLD_OBJECTS=1)
file(READ "${H1_GENERATED}/film_sequential.c" film_source)
hs_beta4_replay_source(blampc_film.c film_source film_source)
hs_beta4_network_replay_source(blampc_film.c film_source film_source)
set(H1_SEQUENTIAL_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/film_beta4.c")
file(WRITE "${H1_SEQUENTIAL_SOURCE}" "${film_source}")
get_target_property(beta4_sources blam_server SOURCES)
list(FILTER beta4_sources EXCLUDE REGEX "(^|/)blampc_bots\\.c$")
list(APPEND beta4_sources "/engines/beta4/wasm/bot-replay.c")
set_property(SOURCE "/engines/beta4/wasm/bot-replay.c" TARGET_DIRECTORY blam_server APPEND PROPERTY COMPILE_OPTIONS -include linux_server_prelude.h -include blampc_prelude.h)
set(beta4_patched)
foreach(source IN LISTS beta4_sources)
    get_filename_component(name "${source}" NAME)
    if(name MATCHES "^(create_local_players|game_engine_player_added|game_engine_build_lighting|player_spawn|blampc_film_join)\\.c$" OR source MATCHES "/engine/blam/")
        file(READ "${source}" original)
        set(patched "${original}")
        if(name MATCHES "^(create_local_players|game_engine_player_added|blampc_film_join)\\.c$")
            hs_beta4_replay_source("${name}" patched patched)
        endif()
        if(name MATCHES "^effect_(evaluate_function_integral|generate_particles)\\.c$")
            set(EMSCRIPTEN TRUE)
            hs_beta4_network_replay_source("${name}" patched patched)
            unset(EMSCRIPTEN)
        else()
            hs_beta4_network_replay_source("${name}" patched patched)
        endif()
        hs_combat_patch("${source}" patched patched)
        if(NOT patched STREQUAL original)
            set(destination "${CMAKE_CURRENT_BINARY_DIR}/beta4/${name}")
            file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/beta4")
            file(WRITE "${destination}" "${patched}")
            list(APPEND beta4_patched "${destination}")
            set_property(SOURCE "${destination}" TARGET_DIRECTORY blam_server APPEND PROPERTY COMPILE_OPTIONS -include linux_server_prelude.h -include blampc_prelude.h)
            if(name STREQUAL "object_cause_damage.c")
                set_property(SOURCE "${destination}" TARGET_DIRECTORY blam_server APPEND PROPERTY COMPILE_DEFINITIONS blampc_pgcr_stats_note_damage=hs_note_damage)
            endif()
            continue()
        endif()
    endif()
    list(APPEND beta4_patched "${source}")
endforeach()
set_property(TARGET blam_server PROPERTY SOURCES "${beta4_patched}")
