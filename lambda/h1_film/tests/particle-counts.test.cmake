cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/../engines/beta4/replay.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../engines/beta4/network-replay.cmake")
foreach(name IN ITEMS effect_evaluate_function_integral.c effect_generate_particles.c)
    file(READ "${H1_SOURCE}/engine/blam/${name}" original)
    set(EMSCRIPTEN TRUE)
    set(H1_NETWORK_REPLAY_FIXES OFF)
    hs_beta4_network_replay_source("${name}" original disabled)
    if(NOT disabled STREQUAL original)
        message(FATAL_ERROR "Disabled correction changed ${name}")
    endif()
    set(H1_NETWORK_REPLAY_FIXES ON)
    set(EMSCRIPTEN FALSE)
    hs_beta4_network_replay_source("${name}" original native)
    if(NOT native STREQUAL original)
        message(FATAL_ERROR "Native oracle changed ${name}")
    endif()
    set(EMSCRIPTEN TRUE)
    hs_beta4_network_replay_source("${name}" original candidate)
    if(candidate STREQUAL original)
        message(FATAL_ERROR "Correction did not change ${name}")
    endif()
    foreach(variant IN ITEMS original candidate)
        file(MAKE_DIRECTORY "${H1_OUTPUT}/${variant}")
        file(WRITE "${H1_OUTPUT}/${variant}/${name}" "${${variant}}")
        if(name STREQUAL "effect_generate_particles.c")
            string(REGEX MATCH "extern (float|double) effect_evaluate_function_integral[^;]+;" prototype "${${variant}}")
            string(REGEX MATCHALL "emit_count = \\(int\\)(\\(float\\))?\\(effect_evaluate_function_integral[^;]+" statements "${${variant}}")
            list(LENGTH statements count)
            if(NOT prototype OR NOT count EQUAL 1)
                message(FATAL_ERROR "Particle count expression changed")
            endif()
            file(WRITE "${H1_OUTPUT}/${variant}/particle-count-expression.h"
                "${prototype}\nstatic int particle_emit_count(int16_t count_function, float fraction, float last_event_fraction, float count_float)\n{\n    int16_t emit_count;\n    ${statements};\n    return emit_count;\n}\n")
        endif()
    endforeach()
endforeach()
