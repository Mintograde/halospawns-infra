{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halospawns.h1MatchReplay.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceContract",
    "source_film_sha256",
    "raw_map_sha256",
    "engine_profile",
    "wasm_sha256",
    "glue_sha256",
    "match_id",
    "tick_rate",
    "authoritative_track",
    "tracks",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "halospawns.h1MatchReplay.v1"
    },
    "sourceContract": {
      "$ref": "#/$defs/sourceContract"
    },
    "source_film_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_map_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engine_profile": {
      "const": "h1-performance-beta6-p9839-wasm-v1"
    },
    "wasm_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "glue_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "match_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "tick_rate": {
      "const": 120
    },
    "authoritative_track": {
      "const": "host"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "source_film_sha256",
          "frame_count",
          "first_update",
          "viewer_revision",
          "world",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(host|client-[0-9]+)$"
          },
          "role": {
            "enum": [
              "host",
              "client"
            ]
          },
          "source_film_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frame_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 432000
          },
          "first_update": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147051647
          },
          "viewer_revision": {
            "const": 5
          },
          "world": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "played_ticks",
              "seed_mismatches",
              "hash_mismatches",
              "hash_checks",
              "control_pushes"
            ],
            "properties": {
              "played_ticks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 432000
              },
              "seed_mismatches": {
                "const": 0
              },
              "hash_mismatches": {
                "const": 0
              },
              "hash_checks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40000
              },
              "control_pushes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 432000
              }
            }
          },
          "recorded_own_player": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "ends_early": {
            "type": "boolean"
          },
          "recorded_trust": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputs",
              "messages",
              "reason"
            ],
            "properties": {
              "inputs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "messages": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "reason": {
                "type": "string",
                "maxLength": 63
              }
            }
          },
          "clocks": {
            "type": "array",
            "maxItems": 432000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frame",
                "game_tick"
              ],
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 432000
                },
                "game_tick": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147051647
                }
              }
            }
          },
          "alignment": {
            "type": "object"
          },
          "account": {
            "type": "object"
          },
          "recorded_sections": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "roster": {
            "type": "object"
          },
          "pad": {
            "type": "object"
          },
          "network": {
            "type": "object"
          },
          "tables": {
            "type": "array",
            "maxItems": 18,
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "compression",
          "offset",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9/_-]{0,120}$"
          },
          "kind": {
            "enum": [
              "world",
              "client-account",
              "host-ledger",
              "raw-pad",
              "network-observations",
              "diagnostic-table",
              "recorded-section"
            ]
          },
          "compression": {
            "const": "identity"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "index_size_bytes": {
            "type": "integer",
            "minimum": 33,
            "maximum": 16777216
          },
          "index_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "profile_revision",
        "projection_sha256",
        "tick_count"
      ],
      "properties": {
        "schema": {
          "const": "halospawns.viewerReplay.v1"
        },
        "profile": {
          "const": "frontend-default"
        },
        "profile_revision": {
          "const": 6
        },
        "projection_sha256": {
          "const": "17891e012b67f5b7e998cf1cc724a1728d18b3df5556559e90fc4ee47c0dc2c2"
        },
        "tick_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 432000
        }
      }
    }
  }
}
