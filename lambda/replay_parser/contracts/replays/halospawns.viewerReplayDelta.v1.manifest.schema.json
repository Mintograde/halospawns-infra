{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halospawns.viewerReplayDelta.v1",
  "title": "HaloSpawns Viewer Replay Delta Container Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sourceContract",
    "replayId",
    "recordedAt",
    "keyframeInterval",
    "tickCount",
    "chunks",
    "replay"
  ],
  "properties": {
    "format": {
      "const": "halospawns.viewerReplayDelta.v1"
    },
    "sourceContract": {
      "$ref": "#/$defs/sourceContract"
    },
    "replayId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "keyframeInterval": {
      "const": 2048
    },
    "tickCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 432000
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 211,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "replay": {
      "$ref": "#/$defs/replayTopLevel"
    }
  },
  "$defs": {
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "profile_revision",
        "projection_sha256",
        "tick_count"
      ],
      "properties": {
        "schema": {
          "const": "halospawns.viewerReplay.v1"
        },
        "profile": {
          "const": "frontend-default"
        },
        "profile_revision": {
          "const": 1
        },
        "projection_sha256": {
          "const": "573da0d397c796d686354b7269094409984304961f8c55ab03bb2e46180d21ec"
        },
        "tick_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 432000
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "offset",
        "firstTick",
        "tickCount",
        "rawBytes",
        "compressedBytes",
        "compressedSha256",
        "tickSha256"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 210
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870911
        },
        "firstTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 431999
        },
        "tickCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "rawBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "compressedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "compressedSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tickSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "replayTopLevel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "object"
        },
        "game_meta": {
          "type": "object"
        },
        "events": {
          "type": "array",
          "maxItems": 200000
        },
        "game_engine_has_teams": {
          "type": "boolean"
        },
        "has_teams": {
          "type": "boolean"
        },
        "network_game_client": {
          "type": "object"
        },
        "network_game_object": {
          "type": "object"
        }
      }
    }
  }
}

