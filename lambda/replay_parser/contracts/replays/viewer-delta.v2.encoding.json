      "translation_step": "1/65536",
      "scale_step": "1/65536",
      "quaternion_levels": 131071,
      "quaternion": "largest_absolute_component_nonnegative_smallest_three",
      "quaternion_quantum": "1/(131071*sqrt(2))",
      "output_numbers": "float32",
      "channels": [
        "translation_x",
        "translation_y",
        "translation_z",
        "scale",
        "quaternion_a",
        "quaternion_b",
        "quaternion_c",
        "quaternion_omitted_index"
