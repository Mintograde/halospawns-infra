    "compression": {
      "name": "zstd",
      "level": 6,
      "checksum": true,
      "independent_frames": true
    },
    "header": [
      "magic:4",
      "base_raw_bytes:uint32",
      "base_compressed_bytes:uint32",
      "poses_raw_bytes:uint32",
      "poses_compressed_bytes:uint32"
    ],
    "layout": [
