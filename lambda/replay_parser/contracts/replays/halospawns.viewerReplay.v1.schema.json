{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.halospawns.com/replays/halospawns.viewerReplay.v1.schema.json",
  "title": "Halospawns Viewer Replay V1",
  "description": "Closed, bounded JSON shape for frontend-default replay viewer artifacts.",
  "type": "object",
  "required": [
    "artifact",
    "ticks"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "game_meta": {
      "$ref": "#/$defs/game_meta"
    },
    "events": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "game_engine_has_teams": {
      "$ref": "#/$defs/boolean_like"
    },
    "has_teams": {
      "$ref": "#/$defs/boolean_like"
    },
    "network_game_client": {
      "$ref": "#/$defs/network_container"
    },
    "network_game_object": {
      "$ref": "#/$defs/network_container"
    },
    "ticks": {
      "type": "array",
      "maxItems": 432000,
      "items": {
        "$ref": "#/$defs/tick"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "schema",
        "profile",
        "profile_revision",
        "projection_sha256",
        "tick_count"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "halospawns.viewerReplay.v1"
        },
        "profile": {
          "const": "frontend-default"
        },
        "profile_revision": {
          "const": 1
        },
        "projection_sha256": {
          "const": "573da0d397c796d686354b7269094409984304961f8c55ab03bb2e46180d21ec"
        },
        "tick_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 432000
        }
      }
    },
    "safe_number": {
      "type": "number",
      "minimum": -1000000000,
      "maximum": 1000000000
    },
    "safe_integer": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 4294967295
    },
    "boolean_like": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      ]
    },
    "reload_state": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      ]
    },
    "identifier": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "$ref": "#/$defs/safe_integer"
        }
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 512
    },
    "path": {
      "type": "string",
      "maxLength": 2048
    },
    "time_text": {
      "type": "string",
      "maxLength": 128
    },
    "duration": {
      "oneOf": [
        {
          "$ref": "#/$defs/safe_number"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+:[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?$",
          "maxLength": 32
        }
      ]
    },
    "local_player_index": {
      "type": "integer",
      "minimum": -1,
      "maximum": 3
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "game_id": {
          "$ref": "#/$defs/identifier"
        },
        "is_full_game": {
          "$ref": "#/$defs/boolean_like"
        },
        "recording_started": {
          "$ref": "#/$defs/time_text"
        },
        "recording_ended": {
          "$ref": "#/$defs/time_text"
        },
        "game_duration_ingame": {
          "$ref": "#/$defs/duration"
        },
        "recording_duration": {
          "$ref": "#/$defs/duration"
        },
        "ticks_elapsed": {
          "$ref": "#/$defs/safe_integer"
        },
        "ticks_recorded": {
          "$ref": "#/$defs/safe_integer"
        },
        "ticks_dropped": {
          "$ref": "#/$defs/safe_integer"
        }
      }
    },
    "sparse_tick_map": {
      "type": "object",
      "maxProperties": 432000,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]{0,8})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/safe_number"
      }
    },
    "nullable_position_axis": {
      "oneOf": [
        {
          "$ref": "#/$defs/safe_number"
        },
        {
          "type": "null"
        }
      ]
    },
    "metric_position": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/nullable_position_axis"
      }
    },
    "metric_positions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/metric_position"
      }
    },
    "position_tick_map": {
      "type": "object",
      "maxProperties": 432000,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]{0,8})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/metric_positions"
      }
    },
    "derived_stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_host": {
          "$ref": "#/$defs/boolean_like"
        },
        "is_hostman": {
          "$ref": "#/$defs/boolean_like"
        }
      }
    },
    "game_meta_derived_stats": {
